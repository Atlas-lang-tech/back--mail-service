generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Audit record of a transactional mail delivery triggered by a domain event.
/// `eventId` is unique — it is the idempotency key for a delivery.
model mailLog {
  id                Int      @id @default(autoincrement())
  eventId           String   @unique
  userId            String
  to                String
  template          String
  providerMessageId String?
  status            String   @default("SENT")
  createdAt         DateTime @default(now())

  @@map("mail_logs")
}
