# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mail?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Mail provider (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
MAIL_FROM="Atlas <no-reply@your-verified-domain.com>"
MAIL_PROVIDER="resend"

# Base URL of the front-end (verification / password-reset links)
APP_BASE_URL="http://localhost:5173"

# Worker rate limiting (optional — defaults: 2 sends / 1000ms)
# MAIL_RATE_MAX=2
# MAIL_RATE_DURATION=1000

# HTTP
PORT=3000

# Note: the task's REDIS_URL is represented here as discrete REDIS_HOST/PORT/DB/
# PASSWORD vars to match the existing RedisService / house convention.
